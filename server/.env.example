NODE_ENV=development
PORT=3000
CLIENT_URL=https://your-skill2career-app.vercel.app

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=skill2career

# Replace with a long, random secret before running outside local development.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d

# Configure this on the server only; never expose it with a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
